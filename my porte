}

/* Hover effet */
.social a:hover {
  transform: scale(1.3);
}

/* Couleurs par réseau */
.social a:nth-child(1):hover { color: #25D366; } /* WhatsApp */
.social a:nth-child(2):hover { color: #1877F2; } /* Facebook */
.social a:nth-child(3):hover { color: #0077B5; } /* LinkedIn */
