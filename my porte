/* BACKGROUND ANIMATION */
.bg-animation {
    
  position: fixed;
  top: 0;
  left: 0;
  right: 2rem;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.loader {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(2);
  opacity: 0.3;
}

.loader span {
  position: absolute;
  width: 150px;
  height: 150px;
}

.loader span:nth-child(1) {
  background: #E1985F;
  backdrop-filter: blur(20px);
  border-radius: 50%;
}

.loader span:nth-child(2) {
  background: #ff2bb2;
  border-radius: 50%;
  animation: bgMove 6s infinite;
}

.loader span:nth-child(3) {
  background: #fff;
  animation: bgMove 6s infinite;
  animation-delay: -3s;
}

@keyframes bgMove {
  0% { transform: translate(-150px, 50px) scale(0.4) rotate(0deg); }
  50% { transform: translate(150px, -50px) scale(0.4) rotate(180deg); }
  100% { transform: translate(-150px, 50px) scale(0.4) rotate(360deg); }
}



