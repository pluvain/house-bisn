    /* ===== NAVBAR GLASSMORPHISM ===== */



/* NAVBAR */
.navbar {
    background: rgba(0, 0, 0, 0.4) !important;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    transition: all 0.4s ease;
}

/* LOGO */
.navbar-brand {
    color: #fff !important;
    font-weight: bold;
    letter-spacing: 2px;
    transition: 0.3s;
}

.navbar-brand:hover {
    color: #00ffcc !important;
}

/* LIENS */
.nav-link {
    color: rgba(255,255,255,0.7) !important;
    margin-left: 20px;
    transition: 0.3s;
    position: relative;
}

/* HOVER */
.nav-link:hover {
    color: #fff !important;
}

/* TRAIT STYLE MODERN */
.nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 0%;
    height: 2px;
    background: #00ffcc;
    transition: 0.4s;
}

.nav-link:hover::after {
    width: 100%;
}

/* BOUTON TOGGLE */
.navbar-toggler {
    border: none;
    outline: none;
    filter: invert(1);
}

/* MENU MOBILE */
@media (max-width: 991px) {
    .navbar-collapse {
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(10px);
        padding: 20px;
        border-radius: 10px;
        margin-top: 10px;
    }

    .nav-link {
        text-align: center;
        margin: 10px 0;
    }
}

/* SCROLL EFFECT */
.navbar.scrolled {
    background: rgba(0,0,0,0.9) !important;
    box-shadow: 0 5px 20px rgba(0,0,0,0.5);
}

.social {
  margin-top: 20px;
  text-align: center;
}

.social a {
  display: inline-block;
  color: white;
  font-size: 24px;
  margin: 0 12px;
